<Page x:Class="CDClean.App.Views.DiskMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDClean.App">
  <Page.Resources>
    <DataTemplate x:Key="RowTpl">
      <Grid Padding="2,4" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="ZoomOut_Invoked"/>
  </Page.KeyboardAccelerators>

  <Grid Padding="28,20,28,16" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- 0 title -->
      <RowDefinition Height="Auto"/>  <!-- 1 toolbar -->
      <RowDefinition Height="Auto"/>  <!-- 2 progress and status -->
      <RowDefinition Height="Auto"/>  <!-- 3 breadcrumb -->
      <RowDefinition Height="Auto"/>  <!-- 4 selection bar -->
      <RowDefinition Height="*"/>     <!-- 5 tree and treemap -->
      <RowDefinition Height="250"/>   <!-- 6 lists and ledger -->
    </Grid.RowDefinitions>

    <StackPanel Spacing="2">
      <TextBlock Text="Disk map" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="Sizes are on-disk (allocated) bytes, as NTFS stores them. Hard links count once. Cloud placeholders count 0. Junctions and symlinks are listed but not followed. * = part of this item could not be read. This page only reads: to delete anything, use Clean or Large files."/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
      <ComboBox x:Name="DrivePick" Width="200" Margin="0,0,8,8" AutomationProperties.Name="Drive"/>
      <Button x:Name="ScanDriveBtn" Content="Scan drive" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" Click="ScanDriveBtn_Click"/>
      <Button x:Name="ScanFolderBtn" Content="Scan folder..." Margin="0,0,8,8" Click="ScanFolderBtn_Click"/>
      <TextBox x:Name="PathBox" Width="260" Margin="0,0,4,8" PlaceholderText="or type a folder path" AutomationProperties.Name="Folder to scan"/>
      <Button x:Name="ScanPathBtn" Content="Scan path" Margin="0,0,8,8" Click="ScanPathBtn_Click"/>
      <Button x:Name="FastScanBtn" Content="Fast scan (admin, MFT)" Margin="0,0,8,8" Click="FastScanBtn_Click"/>
      <Button x:Name="CancelBtn" Content="Cancel" Margin="0,0,8,8" IsEnabled="False" Click="CancelBtn_Click"/>
      <ToggleSwitch x:Name="SizeMode" Margin="0,0,8,8" VerticalAlignment="Center"
                    OffContent="Folder total" OnContent="Files only"
                    AutomationProperties.Name="Size shown" AutomationProperties.AutomationId="SizeMode"
                    Toggled="SizeMode_Toggled"/>
      <DropDownButton Content="Export" Margin="0,0,8,8">
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="Whole tree as CSV" Click="ExportCsv_Click"/>
            <MenuFlyoutItem Text="Summary as JSON" Click="ExportJson_Click"/>
            <MenuFlyoutItem Text="Treemap as PNG" Click="ExportPng_Click"/>
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </StackPanel></ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="4">
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    </StackPanel>

    <ScrollViewer Grid.Row="3" x:Name="CrumbScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Crumbs" Orientation="Horizontal"/>
    </ScrollViewer>

    <Grid Grid.Row="4" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SelText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button x:Name="OpenBtn" Content="Open" IsEnabled="False" Click="OpenBtn_Click"/>
        <Button x:Name="ExplorerBtn" Content="Show in Explorer" IsEnabled="False" Click="ExplorerBtn_Click"/>
        <Button x:Name="PropsBtn" Content="Properties" IsEnabled="False" Click="PropsBtn_Click"/>
        <Button x:Name="CopyBtn" Content="Copy path" IsEnabled="False" Click="CopyBtn_Click"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="5" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="260"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
      <TreeView x:Name="Tree" SelectionMode="Single" Expanding="Tree_Expanding" SelectionChanged="Tree_SelectionChanged">
        <TreeView.ItemTemplate>
          <DataTemplate>
            <Grid ColumnSpacing="8" AutomationProperties.Name="{Binding Content.Name}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Content.Size}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <Border x:Name="MapHost" Grid.Column="1" CornerRadius="4" Background="{ThemeResource ControlFillColorDefaultBrush}" SizeChanged="MapHost_SizeChanged">
        <Canvas x:Name="Map" AutomationProperties.Name="Treemap"/>
      </Border>
    </Grid>

    <Pivot x:Name="Tabs" Grid.Row="6" SelectionChanged="Tabs_SelectionChanged">
      <PivotItem Header="Largest files">
        <Grid RowSpacing="6">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBox x:Name="FindBox" PlaceholderText="Find a file name in this folder" AutomationProperties.Name="Find file name" Width="360" HorizontalAlignment="Left" TextChanged="FindBox_TextChanged"/>
          <ListView Grid.Row="1" x:Name="FilesList" SelectionMode="Single" SelectionChanged="List_SelectionChanged" ItemTemplate="{StaticResource RowTpl}"/>
        </Grid>
      </PivotItem>
      <PivotItem Header="File types">
        <ListView x:Name="TypesList" SelectionMode="None" ItemTemplate="{StaticResource RowTpl}"/>
      </PivotItem>
      <PivotItem Header="Unreadable">
        <ListView x:Name="UnreadList" SelectionMode="Single" SelectionChanged="List_SelectionChanged" ItemTemplate="{StaticResource RowTpl}"/>
      </PivotItem>
      <PivotItem Header="Ledger">
        <ListView x:Name="LedgerList" SelectionMode="None" ItemTemplate="{StaticResource RowTpl}"/>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
