<Page x:Class="CDClean.App.Views.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:CDClean.App.Controls">
  <Grid Padding="28,20" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="Clean" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock Text="Preview lists every file the rules would remove, with its risk. Nothing changes until you press Clean ticked and confirm the review. Caches are deleted; user files go to your backup drive first."
                 TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button x:Name="PreviewBtn" Content="Preview" Click="PreviewBtn_Click" Style="{StaticResource AccentButtonStyle}"/>
      <Button x:Name="CancelBtn" Content="Cancel" Click="CancelBtn_Click"/>
      <Button x:Name="CsvBtn" Content="Export CSV" Click="CsvBtn_Click"/>
      <Button x:Name="JsonBtn" Content="Export JSON" Click="JsonBtn_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="4">
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
      <ProgressBar x:Name="Bar" Maximum="100" Value="0" Visibility="Collapsed"/>
      <TextBlock x:Name="Current" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    </StackPanel>
    <InfoBar Grid.Row="3" x:Name="Explain" Severity="Informational" IsClosable="False" IsOpen="False"/>
    <c:ItemsGrid Grid.Row="4" x:Name="Table" LayoutKey="Clean" ColumnSpec="Name,App:Rule,Size,Modified,Risk,Action,Extra:Notes,Path"
                 EmptyText="Press Preview to see what the rules would remove.">
      <c:ItemsGrid.Actions>
        <Button x:Name="CleanBtn" Content="Clean ticked" Click="CleanBtn_Click" Style="{StaticResource AccentButtonStyle}"/>
      </c:ItemsGrid.Actions>
    </c:ItemsGrid>
  </Grid>
</Page>
