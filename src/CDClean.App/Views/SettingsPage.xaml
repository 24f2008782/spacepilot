<Page x:Class="CDClean.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="28,20" ColumnSpacing="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="8">
      <TextBox x:Name="SearchBox" PlaceholderText="Search settings" TextChanged="SearchBox_TextChanged"/>
      <ListView x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged">
        <ListView.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="14"/>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
        <Button Content="Reset category" Click="ResetCategory_Click"/>
        <Button Content="Reset all" Click="ResetAll_Click"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer Grid.Column="1">
      <StackPanel x:Name="ContentPanel" Spacing="12" MaxWidth="760" HorizontalAlignment="Left"/>
    </ScrollViewer>
  </Grid>
</Page>