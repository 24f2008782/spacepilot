<Page x:Class="CDClean.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:CDClean.App.Controls">
  <Grid Padding="28,20" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="Apps" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock Text="Installed programs. Uninstall opens each program's own uninstaller. Use Filters > Drive to see programs installed on one drive; their settings still live on the system drive." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button x:Name="LoadBtn" Content="Refresh" Click="LoadBtn_Click" Style="{StaticResource AccentButtonStyle}"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="4">
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    </StackPanel>
    <c:ItemsGrid Grid.Row="3" x:Name="Table" AppRows="True" LayoutKey="Apps" ColumnSpec="Name,Source,App:Publisher,Extra:Version,Modified:Installed,Size,Path:Location" EmptyText="Loading installed programs...">
      <c:ItemsGrid.Actions>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="OpenBtn" Content="Open folder" Click="OpenBtn_Click"/>
          <Button x:Name="UninstallBtn" Content="Uninstall" Click="UninstallBtn_Click"/>
        </StackPanel>
      </c:ItemsGrid.Actions>
    </c:ItemsGrid>
    <Border Grid.Row="4" Padding="12" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <TextBlock x:Name="Details" Text="Select a program to see its install location, metadata key, source and pre-flight checks." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
    </Border>
  </Grid>
</Page>
