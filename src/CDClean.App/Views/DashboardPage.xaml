<Page x:Class="CDClean.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDClean.App">
  <ScrollViewer>
    <StackPanel Padding="28,20" Spacing="16">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}"/>
        <ComboBox Grid.Column="1" x:Name="DrivePick" Width="320" SelectionChanged="DrivePick_SelectionChanged" AutomationProperties.Name="Drive"/>
      </Grid>
      <InfoBar x:Name="LowSpace" Severity="Warning" IsClosable="False"/>

      <Grid x:Name="Cards" ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="6">
            <TextBlock x:Name="FreeLabel" Text="Free on C:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="FreeText" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <ProgressBar x:Name="UsedBar" Maximum="100"/>
            <TextBlock x:Name="UsedText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel Spacing="6">
            <TextBlock Text="Reclaimable by rules (C:)" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ReclaimText" Text="Scan to see" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock x:Name="ReclaimNote" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel Spacing="6">
            <TextBlock Text="Freed so far" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="FreedText" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock x:Name="RunsText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Style="{StaticResource Card}">
          <StackPanel Spacing="6">
            <TextBlock Text="Schedule" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ScheduleText" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock x:Name="BackupText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="QuickScanBtn" Content="Quick scan" Style="{StaticResource AccentButtonStyle}" Click="QuickScanBtn_Click"/>
        <Button x:Name="GoCleanBtn" Content="Review and clean" Click="GoCleanBtn_Click"/>
        <Button x:Name="GoSystemBtn" Content="System cleanup (admin)" Click="GoSystemBtn_Click"/>
      </StackPanel>
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>

      <TextBlock Text="Space freed per run" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <TextBlock x:Name="NoHistory" Text="No runs yet." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ItemsControl x:Name="HistoryList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnSpacing="12" Padding="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/><ColumnDefinition Width="210"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Title}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <Border Grid.Column="1" Height="10" CornerRadius="5" VerticalAlignment="Center" Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                <Rectangle HorizontalAlignment="Left" Width="{Binding Bar}" RadiusX="5" RadiusY="5" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
              </Border>
              <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
