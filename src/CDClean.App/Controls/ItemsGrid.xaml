<UserControl x:Class="CDClean.App.Controls.ItemsGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.UI.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="CheckCell">
      <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" MinWidth="0" Margin="10,0,0,0" HorizontalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate x:Key="RiskCell">
      <Border Background="{Binding RiskBrush}" CornerRadius="6" Padding="8,1" Margin="6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="{Binding RiskText}" Foreground="White" FontSize="12"/>
      </Border>
    </DataTemplate>
    <Style x:Key="RightText" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0"/>
    </Style>
    <Style x:Key="LeftText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </UserControl.Resources>

  <Grid RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Two-level search -->
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="Search" PlaceholderText="Search all results (Ctrl+F)" QueryIcon="Find" TextChanged="Search_TextChanged"/>
      <AutoSuggestBox Grid.Column="1" x:Name="Within" PlaceholderText="Search within these results (Ctrl+Shift+F)" QueryIcon="Filter" TextChanged="Search_TextChanged"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="FiltersBtn" Content="Filters">
          <Button.Flyout>
            <Flyout x:Name="FiltersFlyout">
              <StackPanel Spacing="10" Width="260">
                <NumberBox x:Name="MinSizeBox" Header="Size at least (MB)" Minimum="0" Value="0" SpinButtonPlacementMode="Compact"/>
                <NumberBox x:Name="MinAgeBox" Header="Not changed for at least (months)" Minimum="0" Value="0" SpinButtonPlacementMode="Compact"/>
                <ComboBox x:Name="DriveBox" Header="Drive" HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Apply" Click="ApplyFilters_Click" Style="{StaticResource AccentButtonStyle}"/>
                  <Button Content="Clear" Click="ClearFilters_Click"/>
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="ColumnsBtn" Content="Columns"/>
      </StackPanel>
    </Grid>

    <!-- Active filter chips -->
    <StackPanel Grid.Row="1" x:Name="Chips" Orientation="Horizontal" Spacing="6" Visibility="Collapsed"/>

    <!-- Selection bar + page actions -->
    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <CheckBox x:Name="HeaderCheck" IsThreeState="True" MinWidth="0" Margin="10,0,0,0" Click="HeaderCheck_Click"
                ToolTipService.ToolTip="Tick or untick every visible row" AutomationProperties.Name="Select all visible rows"/>
      <TextBlock Grid.Column="1" x:Name="SelText" VerticalAlignment="Center" FontWeight="SemiBold" Text="0 selected"/>
      <ScrollViewer Grid.Column="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="Select visible" Click="SelectVisible_Click" ToolTipService.ToolTip="Ctrl+A"/>
          <Button Content="Select all matching" Click="SelectMatching_Click" ToolTipService.ToolTip="Every row that matches the first search box, including rows hidden by the second"/>
          <Button Content="Invert visible" Click="Invert_Click" ToolTipService.ToolTip="Ctrl+I"/>
          <Button Content="Clear" Click="Clear_Click" ToolTipService.ToolTip="Ctrl+Shift+A"/>
        </StackPanel>
      </ScrollViewer>
      <ContentPresenter Grid.Column="3" x:Name="ActionsHost"/>
    </Grid>

    <!-- Warnings that cannot be dismissed while they are true -->
    <StackPanel Grid.Row="3" Spacing="4">
      <InfoBar x:Name="HiddenBar" Severity="Warning" IsClosable="False" IsOpen="False">
        <InfoBar.ActionButton>
          <Button Content="Show hidden selections" Click="ShowHidden_Click"/>
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar x:Name="StaleBar" Severity="Error" IsClosable="False" IsOpen="False">
        <InfoBar.ActionButton>
          <Button Content="Unselect missing items" Click="DropStale_Click"/>
        </InfoBar.ActionButton>
      </InfoBar>
    </StackPanel>

    <ctk:DataGrid Grid.Row="4" x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True"
                  SelectionMode="Single" GridLinesVisibility="None" HeadersVisibility="Column"
                  RowHeight="32" ColumnHeaderHeight="34"
                  Sorting="Table_Sorting" DoubleTapped="Table_DoubleTapped" PreviewKeyDown="Table_PreviewKeyDown"/>

    <TextBlock Grid.Row="4" x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
  </Grid>
</UserControl>
